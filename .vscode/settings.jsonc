{
    // 保存自动删除末尾空格
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "window.zoomLevel": 0,
    "editor.multiCursorModifier": "ctrlCmd", // 按住 添加多光标
    "editor.scrollBeyondLastLine": true,
    "chat.disableAIFeatures": true, // 关闭 Copilot / AI chat 功能
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "editor.formatOnPaste": true, // 粘贴时自动缩进
    "window.titleBarStyle": "native",
    "window.customTitleBarVisibility": "never", // 隐藏顶部自定义标题栏
    "editor.find.addExtraSpaceOnTop": false, // 控制查找禁止在编辑器顶部添加额外的行
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    // "editor.renderWhitespace": "boundary",
    "editor.smoothScrolling": true,
    "editor.cursorBlinking": "expand",
    "editor.cursorSmoothCaretAnimation": "on",
    "workbench.startupEditor": "none",
    "workbench.list.smoothScrolling": true,
    "workbench.editor.closeOnFileDelete": true,
    "editor.mouseWheelZoom": true,
    "editor.wordWrap": "on",
    "editor.lineHeight": 1.5,
    "editor.rulers": [
        100
    ], // 显式代码分割线
    "editor.fastScrollSensitivity": 10,
    "editor.guides.bracketPairs": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.suggestSelection": "recentlyUsedByPrefix",
    "editor.suggest.insertMode": "replace",
    // 设置滚动条, hidden始终隐藏, visible始终显示
    "editor.scrollbar.vertical": "auto",
    "editor.scrollbar.horizontal": "auto",
    // 补全括号选择
    "editor.autoClosingBrackets": "beforeWhitespace",
    "editor.autoClosingDelete": "always",
    "editor.autoClosingOvertype": "always",
    "editor.autoClosingQuotes": "beforeWhitespace",
    // 关闭缩进猜测
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "window.dialogStyle": "custom",
    "window.nativeTabs": true,
    "window.title": "${rootName}",
    "debug.showBreakpointsInOverviewRuler": true,
    // Tab 高度紧凑模式
    "window.density.editorTabHeight": "compact",
    "explorer.compactFolders": false, // 展开文件夹
    "notebook.compactView": true,
    // 自动补齐`HTML`尖括号
    "editor.linkedEditing": true,
    "html.format.wrapAttributes": "preserve",
    "html.format.wrapLineLength": 100,
    "html.format.indentHandlebars": true,
    // 格式化自动删分号
    "js/ts.format.semicolons": "remove",
    // 类型提示
    "js/ts.inlayHints.functionLikeReturnTypes.enabled": false,
    "js/ts.inlayHints.parameterNames.enabled": "none",
    "js/ts.inlayHints.enumMemberValues.enabled": true,
    "js/ts.locale": "zh-CN",
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "js/ts.preferences.includePackageJsonAutoImports": "on",
    "js/ts.suggest.autoImports": true,
    "js/ts.preferences.quoteStyle": "single",
    "files.autoGuessEncoding": false,
    // 搜索吸附目录
    "search.searchEditor.singleClickBehaviour": "peekDefinition",
    "editor.stickyScroll.enabled": false, // 禁用粘性滚动功能
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.indent": 15, // 设置目录树缩进
    "workbench.list.openMode": "doubleClick", // 双击打开文件
    // 终端配置
    "code-runner.clearPreviousOutput": true,
    "code-runner.runInTerminal": true,
    "terminal.integrated.fontFamily": "Maple Mono NF CN, Menlo, Consolas, Maple UI, PingFang, 'Microsoft YaHei', monospace",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.stickyScroll.enabled": true,
    "terminal.integrated.inheritEnv": true,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.cursorStyleInactive": "line",
    "terminal.integrated.scrollback": 1000,
    "accessibility.signals.terminalCommandFailed": {
        "sound": "auto",
        "announcement": "auto"
    },
    "workbench.fontAliasing": "antialiased",
    "editor.fontFamily": "Maple Mono NF CN, Menlo, Consolas, Maple UI, PingFang, 'Microsoft YaHei', monospace",
    "editor.fontLigatures": "'calt', 'cv01', 'ss01', 'zero'",
    "editor.fontSize": 11,
    "editor.fontWeight": "normal",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.list.fastScrollSensitivity": 10,
    "workbench.colorTheme": "JetBrains Darcula Theme",
    "workbench.editor.tabActionLocation": "left",
    "editor.foldingImportsByDefault": true,
    "workbench.editor.highlightModifiedTabs": true, // 高亮显示修改过的文件
    // index 替换成 目录名
    "workbench.editor.customLabels.patterns": {
        "**/index.vue": "${dirname}.vue",
        "**/index.js": "${dirname}.js",
        "**/index.ts": "${dirname}.ts",
        "**/index.jsx": "${dirname}.jsx",
        "**/index.tsx": "${dirname}.tsx"
    },
    "markdown.updateLinksOnFileMove.enabled": "prompt",
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    // 行内样式代码补全
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    "editor.wordSeparators": "`~!@%^&*()=+[{]}\\|;:'\",.<>/?（），。；：",
    // 配置代码缩略图
    "editor.minimap.enabled": false, // 启用/禁用缩略图, codemap
    "editor.minimap.maxColumn": 120, // 设置缩略图最大宽度
    "editor.minimap.renderCharacters": true, // 是否渲染实际字符
    "editor.minimap.side": "right", // 缩略图位置（right/left）
    "editor.minimap.showSlider": "mouseover", // 滑块显示方式
    "editor.foldingStrategy": "auto",
    "editor.foldingHighlight": false,
    "editor.snippetSuggestions": "top",
    "editor.tabCompletion": "on",
    "extensions.ignoreRecommendations": true,
    // JSX
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact"
    },
    "search.followSymlinks": false,
    "update.mode": "manual",
    "search.exclude": {
        "**/*.sql": true,
        "**/*.snap": true,
        "**/*.svg": true,
        "**/.git": true,
        "**/.github": false,
        "**/.nuxt": true,
        "**/.output": true,
        "**/.pnpm": true,
        "**/.vscode": true,
        "**/.yarn": true,
        "**/assets": true,
        "**/bower_components": true,
        "**/dist/**": true,
        "**/logs": true,
        "**/node_modules": true,
        "**/out/**": true,
        "**/package-lock.json": true,
        "**/pnpm-lock.yaml": true,
        "**/public": true,
        "**/temp": true,
        "**/yarn.lock": true,
        "**/CHANGELOG*": true,
        "**/LICENSE*": true,
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/node_modules/**": true,
        "**/.pnpm/**": true,
        "**/dist/**": true,
        "**/.next/**": true,
        "**/.nuxt/**": true,
        "**/.output/**": true,
        "**/coverage/**": true,
        "**/.turbo/**": true,
        "**/.cache/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.venv/**": true
    },
    "editor.accessibilitySupport": "off", // 关闭无障碍支持（减少额外 DOM 计算）
    "editor.codeLens": false, // 关闭 CodeLens（引用数等行内提示）
    "editor.colorDecorators": false, // 关闭颜色装饰器（CSS 色块预览）
    "editor.links": false, // 禁止编辑器内链接检测和渲染
    "editor.occurrencesHighlight": "off", // 关闭光标所在单词的自动高亮
    "editor.renderControlCharacters": false, // 关闭控制字符渲染
    "editor.glyphMargin": false, // 关闭字形边距（断点图标区域，如不调试可关）
    "editor.parameterHints.enabled": false, // 关闭函数参数提示弹窗
    "editor.matchBrackets": "near", // 括号匹配仅在光标紧邻时触发（默认 always）
    "editor.maxTokenizationLineLength": 5000, // 超长行不做语法高亮，防止卡顿
    "editor.dragAndDrop": false, // 禁用拖拽移动代码
    "telemetry.telemetryLevel": "off", // 关闭遥测
    "workbench.enableExperiments": false, // 关闭 A/B 实验功能
    "workbench.settings.enableNaturalLanguageSearch": false, // 关闭设置页 AI 搜索
    // 配置文件关联
    "files.associations": {
        // 比如小程序中的 .wxss 这种文件 会把它作为css文件来处理 提供对应的css的语法提示 css的格式化等。
        "*.wxss": "css",
        "*.wxml": "html",
        "*.svg": "html",
        "*.xml": "html",
        "*.wxs": "javascript",
        // json注释
        "*.cjson": "jsonc",
        "*.json": "jsonc"
    },
    "css.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore",
    "less.lint.unknownAtRules": "ignore",
    "explorer.copyRelativePathSeparator": "/",
    "files.exclude": { // 隐藏文件夹
        "**/__pycache__": true,
        "**/.ruff_cache": true,
        "**/.idea": true,
        "**/.vscode": true,
        "**/node_modules": true,
        "**/.venv": true,
    },
    "files.eol": "\n", // 保存文件换行符为 unix 格式
    "files.encoding": "utf8",
    "files.simpleDialog.enable": true,
    "extensions.autoUpdate": "onlyEnabledExtensions", // 自动更新扩展
    "explorer.openEditors.visible": 5, // “打开编辑器”窗格中显示的初始编辑器数上限, 超过此限制将显示滚动条
    "window.restoreWindows": "all", // 恢复之前打开的所有窗口和文件夹
    "workbench.editor.enablePreview": false, // 禁用文件预览模式，确保双击时文件独立打开
    "editor.inlineSuggest.enabled": false,
    "window.openFoldersInNewWindow": "on",
    "chat.commandCenter.enabled": false, // 隐藏copilot
    "editor.lightbulb.enabled": "off",
    "breadcrumbs.enabled": false,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "comment",
                "settings": { // 设置代码的注释部分为斜体
                    "fontStyle": "italic"
                }
            }
        ]
    },
    // 禁用 git 文件树装饰（大型仓库明显提升侧边栏响应速度）
    "git.decorations.enabled": false,
    // 限制 TS Server 内存上限，防止大型项目内存膨胀（按需调整）
    "js/ts.tsserver.maxMemory": 4096,
    // 悬停提示延迟，减少无意触发的计算开销
    "editor.hover.delay": 500,
    // 禁用不需要的内置扩展（如果不用的话）
    "npm.autoDetect": "off",
    "grunt.autoDetect": "off",
    "gulp.autoDetect": "off",
    "jake.autoDetect": "off",
    // 自定义背景颜色
    "workbench.colorCustomizations": {
        "editorRuler.foreground": "#363636", // 标尺线颜色
        "editor.background": "#2B2B2B", // 设置编辑器背景颜色
        "editor.foreground": "#FFFFFF", // 设置编辑器前景颜色
        "sideBar.background": "#2B2B2B", // 侧边栏背景色
        "sideBarSectionHeader.background": "#2B2B2B", // 侧边栏分组标题的背景色
        "sideBar.border": "#363636", // 侧边栏边框颜色
        "terminal.background": "#2B2B2B", // 终端背景色
        "panel.background": "#2B2B2B", // 面板背景色
        "activityBar.background": "#2B2B2B", // 添加这一行来设置活动栏背景色
        "tab.activeBackground": "#2B2B2B", // 活动标签背景
        "tab.inactiveBackground": "#2B2B2B", // 非活动标签背景
        "tab.border": "#222222", // 标签边框颜色
        "editorGroupHeader.tabsBackground": "#2B2B2B", // 标签栏整体背景
        // "list.activeSelectionBackground": "#3E66C5", // 选中项的背景色
        "list.inactiveSelectionBackground": "#15293D", // 非焦点时选中项的背景色
        // "list.hoverBackground": "#2B2B2B", // 鼠标悬停时的背景色
        // "list.inactiveFocusBackground": "#2B2B2B", // 非焦点时的背景色
        // "list.inactiveSelectionForeground": "#ffffff", // 非焦点时选中项的文字颜色
        // "list.dropBackground": "#2B2B2B", // 拖放时的背景色
        "titleBar.activeBackground": "#2B2B2B", // 标题栏背景色
        "titleBar.border": "#363636", // 标题栏边框颜色
        // "titleBar.inactiveBackground": "#2B2B2B", // 非活动标题栏背景色
        "breadcrumb.background": "#2B2B2B", // 面包屑导航背景
        // "breadcrumbPicker.background": "#2B2B2B", // 面包屑选择器背景
        // "editorGroupHeader.border": "#00000000", // 编辑器组标题栏边框
        "statusBar.background": "#2B2B2B", // 状态栏背景色
        "statusBar.border": "#363636", // 下方状态栏边框
        // "statusBar.noFolderBackground": "#2B2B2B", // 未打开文件夹时的状态栏背景
        // "statusBar.debuggingBackground": "#2B2B2B", // 调试时的状态栏背景
        // "statusBarItem.activeBackground": "#2B2B2B", // 状态栏项目激活时的背景
        // "statusBarItem.hoverBackground": "#2B2B2B", // 状态栏项目悬停时的背景
        "editorGutter.background": "#2B2B2B", // 设置行号区域背景色
        "editorGroupHeader.tabsBorder": "#222222", // 设置头部标签颜色
        "panel.border": "#363636", // 隐藏终端面板与编辑器边框
        "sideBarSectionHeader.border": "#363636", // 隐藏大纲与时间线边界色
        "activityBar.border": "#363636", // 隐藏活动栏分隔侧边栏边框
        "editor.lineHighlightBorder": "#00000000", // 去掉当前行边框
        "editorLineNumber.foreground": "#555555", // 行号颜色
        "editorCursor.foreground": "#3E66C5", // 光标颜色
        "editor.lineHighlightBackground": "#2F2F2F", // 当前行高亮（很实用！）
        "editorLineNumber.activeForeground": "#CCCCCC", // 当前行行号（高亮）
        "scrollbarSlider.background": "#44444466", // 滚动条默认
        "scrollbarSlider.hoverBackground": "#55555588", // 悬停
        "scrollbarSlider.activeBackground": "#666666AA", // 拖动时
        "editor.findMatchBackground": "#3E66C566", // 当前搜索匹配
        "editor.findMatchHighlightBackground": "#3E66C533", // 其他匹配项
        "editor.selectionBackground": "#3E66C544", // 选中文本
        "editor.selectionHighlightBackground": "#3E66C522", // 与选中文本相同的其他文本
        "editor.wordHighlightBackground": "#3E66C533", // 光标所在单词的其他出现位置
    },
    // code spell白名单
    "cSpell.words": [
        "myCustomWord",
        "foobar",
        "xuehui",
        "k8s",
        "cmdb",
        "oceanbase",
        "nopcloudnet"
    ],
    // 文件列表配置
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        ".agent": ".agent, .claude, .cline, .codebuddy, .codex, .commandcode, .continue, .crush, .cursor, .factory, .gemini, .goose, .junie, .kilocode, .kiro, .kode, .mcpjam, .mux, .neovate, .opencode, .openhands, .pi, .pochi, .qoder, .qwen, .roo, .trae, .windsurf, .zencoder",
        ".clang-tidy": ".clang-format, .clangd, compile_commands.json",
        ".env": "*.env, .env.*, .envrc, env.d.ts",
        ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .lfsconfig, .mailmap, .git-blame*",
        ".project": ".classpath",
        "+layout.svelte": "+layout.ts,+layout.js,+layout.server.ts,+layout.server.js,+layout.gql",
        "+page.svelte": "+page.server.ts,+page.server.js,+page.ts,+page.js,+page.gql",
        "AGENTS.md": ".clinerules, .cursorrules, .replit.md, .windsurfrules, AGENT.md, CLAUDE.local.md, CLAUDE.md, GEMINI.md",
        "ansible.cfg": "ansible.cfg, .ansible-lint, requirements.yml",
        "app.config.*": "*.env, .babelrc*, .codecov, .cssnanorc*, .env.*, .envrc, .htmlnanorc*, .lighthouserc.*, .mocha*, .postcssrc*, .terserrc*, api-extractor.json, ava.config.*, babel.config.*, capacitor.config.*, content.config.*, contentlayer.config.*, cssnano.config.*, cypress.*, env.d.ts, formkit.config.*, formulate.config.*, histoire.config.*, htmlnanorc.*, i18n.config.*, ionic.config.*, jasmine.*, jest.config.*, jsconfig.*, karma*, lighthouserc.*, panda.config.*, playwright.config.*, postcss.config.*, puppeteer.config.*, react-router.config.*, rspack.config.*, sst.config.*, svgo.config.*, tailwind.config.*, tsconfig.*, tsdoc.*, uno.config.*, unocss.config.*, vitest.config.*, vuetify.config.*, webpack.config.*, windi.config.*",
        "application.properties": "*.properties",
        "artisan": "*.env, .babelrc*, .codecov, .cssnanorc*, .env.*, .envrc, .htmlnanorc*, .lighthouserc.*, .mocha*, .postcssrc*, .terserrc*, api-extractor.json, ava.config.*, babel.config.*, capacitor.config.*, content.config.*, contentlayer.config.*, cssnano.config.*, cypress.*, env.d.ts, formkit.config.*, formulate.config.*, histoire.config.*, htmlnanorc.*, i18n.config.*, ionic.config.*, jasmine.*, jest.config.*, jsconfig.*, karma*, lighthouserc.*, panda.config.*, playwright.config.*, postcss.config.*, puppeteer.config.*, react-router.config.*, rspack.config.*, server.php, sst.config.*, svgo.config.*, tailwind.config.*, tsconfig.*, tsdoc.*, uno.config.*, unocss.config.*, vitest.config.*, vuetify.config.*, webpack.config.*, webpack.mix.js, windi.config.*",
        "astro.config.*": "*.env, .babelrc*, .codecov, .cssnanorc*, .env.*, .envrc, .htmlnanorc*, .lighthouserc.*, .mocha*, .postcssrc*, .terserrc*, api-extractor.json, ava.config.*, babel.config.*, capacitor.config.*, content.config.*, contentlayer.config.*, cssnano.config.*, cypress.*, env.d.ts, formkit.config.*, formulate.config.*, histoire.config.*, htmlnanorc.*, i18n.config.*, ionic.config.*, jasmine.*, jest.config.*, jsconfig.*, karma*, lighthouserc.*, panda.config.*, playwright.config.*, postcss.config.*, puppeteer.config.*, react-router.config.*, rspack.config.*, sst.config.*, svgo.config.*, tailwind.config.*, tsconfig.*, tsdoc.*, uno.config.*, unocss.config.*, vitest.config.*, vuetify.config.*, webpack.config.*, windi.config.*",
        "build-wrapper.log": "build-wrapper*.log, build-wrapper-dump*.json, build-wrapper-win*.exe, build-wrapper-linux*, build-wrapper-macosx*",
        "BUILD.bazel": "*.bzl, *.bazel, *.bazelrc, bazel.rc, .bazelignore, .bazelproject, .bazelversion, MODULE.bazel.lock, WORKSPACE",
        "build.gradle": "settings.gradle, gradlew, gradlew.bat, gradle.properties, gradle.lockfile",
        "build.gradle.kts": "settings.gradle.kts, gradlew, gradlew.bat, gradle.properties, gradle.lockfile",
        "Cargo.toml": ".clippy.toml, .rustfmt.toml, Cargo.Bazel.lock, Cargo.lock, clippy.toml, cross.toml, insta.yaml, rust-toolchain.toml, rustfmt.toml",
        "CMakeLists.txt": "*.cmake, *.cmake.in, .cmake-format.yaml, CMakePresets.json, CMakeCache.txt",
        "composer.json": ".php*.cache, composer.lock, phpunit.xml*, psalm*.xml",
        "default.nix": "shell.nix",
        "deno.json*": "*.env, .env.*, .envrc, api-extractor.json, deno.lock, env.d.ts, import-map.json, import_map.json, jsconfig.*, tsconfig.*, tsdoc.*",
        "Dockerfile": "*.dockerfile, .devcontainer.*, .dockerignore, Dockerfile*, captain-definition, compose.*, docker-compose.*, dockerfile*",
        "flake.nix": "default.nix, shell.nix, flake.lock",
        "gatsby-config.*": "*.env, .babelrc*, .codecov, .cssnanorc*, .env.*, .envrc, .htmlnanorc*, .lighthouserc.*, .mocha*, .postcssrc*, .terserrc*, api-extractor.json, ava.config.*, babel.config.*, capacitor.config.*, content.config.*, contentlayer.config.*, cssnano.config.*, cypress.*, env.d.ts, formkit.config.*, formulate.config.*, gatsby-browser.*, gatsby-node.*, gatsby-ssr.*, gatsby-transformer.*, histoire.config.*, htmlnanorc.*, i18n.config.*, ionic.config.*, jasmine.*, jest.config.*, jsconfig.*, karma*, lighthouserc.*, panda.config.*, playwright.config.*, postcss.config.*, puppeteer.config.*, react-router.config.*, rspack.config.*, sst.config.*, svgo.config.*, tailwind.config.*, tsconfig.*, tsdoc.*, uno.config.*, unocss.config.*, vitest.config.*, vuetify.config.*, webpack.config.*, windi.config.*",
        "gemfile": ".ruby-version, gemfile.lock",
        "go.mod": ".air*, go.sum",
        "go.work": "go.work.sum",
        "hatch.toml": ".editorconfig, .flake8, .isort.cfg, .python-version, hatch.toml, requirements*.in, requirements*.pip, requirements*.txt, tox.ini",
        "I*.cs": "$(capture).cs",
        "justfile": "*.just, .justfile",
        "Makefile": "*.mk",
