# ==== 版本 & 通用 ====
STACK_VERSION=9.4.4
TZ=Asia/Shanghai
BIND_ADDR=127.0.0.1          # 只想本机访问就保持这个;要放公网再说

# ==== Elasticsearch ====
ES_MEM_LIMIT=6g  # 容器内存
ELASTIC_PASSWORD=123456
ES_JAVA_OPTS="-Xms3g -Xmx3g"  # ES JVM Heap：3GB，6GB 容器内存下建议保留约一半给 Lucene Cache 等

# ==== Logstash ====
LS_MEM_LIMIT=2g
LOGSTASH_ES_USERNAME=logstash_writer  # 手动创建的ES用户，用于 Logstash 写入
LOGSTASH_ES_PASSWORD=123456
LS_JAVA_OPTS="-Xms1g -Xmx1g"

# ==== Kibana ====
KIBANA_MEM_LIMIT=1g
KIBANA_PASSWORD=123456

# 用官方自带的 kibana-encryption-keys 工具生成加密秘钥:
# docker run --rm docker.elastic.co/kibana/kibana:9.4.4 /usr/share/kibana/bin/kibana-encryption-keys generate -q

XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=8023d0e791b4b92fdb18543b3fb6020c12e804d0851037ab95ed90b8e858a2a9
XPACK_REPORTING_ENCRYPTIONKEY=8b175fa9ca3bb9624af080878a267d7c7f3912bec14c8ee806f8030af314f36d
XPACK_SECURITY_ENCRYPTIONKEY=5ee5f832bacb7b5c50ffe5e8c55bb361f730d20d9e0fd1ea5fe4afe1652ea91d
