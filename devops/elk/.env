# ==== 版本 & 通用 ====
STACK_VERSION=9.4.4
TZ=Asia/Shanghai
BIND_ADDR=127.0.0.1          # 只想本机访问就保持这个;要放公网再说

# ==== Elasticsearch ====
ES_MEM_LIMIT=6g  # 容器内存
ELASTIC_PASSWORD=123456
ES_JAVA_OPTS="-Xms3g -Xmx3g"  # ES JVM Heap：3GB，6GB 容器内存下建议保留约一半给 Lucene Cache 等

# ==== Logstash ====
LS_MEM_LIMIT=2g
LOGSTASH_ES_USERNAME=logstash_writer  # 手动创建的ES用户，用于 Logstash 写入
LOGSTASH_ES_PASSWORD=123456
LS_JAVA_OPTS="-Xms1g -Xmx1g"

# ==== Kibana ====
KIBANA_MEM_LIMIT=1g
KIBANA_PASSWORD=123456

# 用官方自带的 kibana-encryption-keys 工具生成加密秘钥:
# docker run --rm docker.elastic.co/kibana/kibana:9.4.4 /usr/share/kibana/bin/kibana-encryption-keys generate

XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=a7f3c1e9b25d468af0c3e5d7b9128f46
XPACK_REPORTING_ENCRYPTIONKEY=d4b8e2f6a1c93705e8d2b4f6a0c17e39
XPACK_SECURITY_ENCRYPTIONKEY=c1e7a9d3b5f28460c2e4a6d8b0f13579
